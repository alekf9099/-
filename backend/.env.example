SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite:///./aishotmaker.db
STORAGE_DIR=storage
BASE_URL=http://localhost:8000

FREE_CREDITS=5

# Google 소셜 로그인 - Android 앱 build.gradle.kts와 연동되는 OAuth 2.0 웹 클라이언트 ID
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# AI 모델 인물 이미지 Provider: local(기본, 도형 일러스트) | pollinations(무료, 가입/키 불필요, AI 사진풍) | replicate(고품질, REPLICATE_API_TOKEN 필요)
MODEL_IMAGE_PROVIDER=local
# 가상 피팅(VTON) Provider: local(기본, 합성 이미지) | replicate(실제 AI 가상 피팅, REPLICATE_API_TOKEN 필요)
VTON_PROVIDER=local
REPLICATE_API_TOKEN=
