SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite:///./aishotmaker.db
STORAGE_DIR=storage
BASE_URL=http://localhost:8000

FREE_CREDITS=5

# Google 소셜 로그인 - Android 앱 build.gradle.kts와 연동되는 OAuth 2.0 웹 클라이언트 ID
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# AI 이미지 생성 Provider: local(기본, API 키 불필요) | replicate(실제 AI 이미지)
MODEL_IMAGE_PROVIDER=local
VTON_PROVIDER=local
REPLICATE_API_TOKEN=
