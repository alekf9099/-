<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.aishotmaker.ui.splash.SplashFragment"
        android:label="스플래시"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.aishotmaker.ui.auth.LoginFragment"
        android:label="로그인"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.aishotmaker.ui.auth.RegisterFragment"
        android:label="회원가입"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.aishotmaker.ui.home.HomeFragment"
        android:label="홈"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_camera"
            app:destination="@id/cameraFragment" />
        <action
            android:id="@+id/action_home_to_subscription"
            app:destination="@id/subscriptionFragment" />
        <action
            android:id="@+id/action_home_to_result"
            app:destination="@id/resultFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.aishotmaker.ui.camera.CameraFragment"
        android:label="촬영"
        tools:layout="@layout/fragment_camera">
        <action
            android:id="@+id/action_camera_to_editor"
            app:destination="@id/editorFragment" />
    </fragment>

    <fragment
        android:id="@+id/editorFragment"
        android:name="com.aishotmaker.ui.editor.EditorFragment"
        android:label="편집"
        tools:layout="@layout/fragment_editor">
        <argument
            android:name="imagePath"
            app:argType="string" />
        <action
            android:id="@+id/action_editor_to_processing"
            app:destination="@id/processingFragment" />
        <action
            android:id="@+id/action_editor_to_subscription"
            app:destination="@id/subscriptionFragment" />
    </fragment>

    <fragment
        android:id="@+id/processingFragment"
        android:name="com.aishotmaker.ui.result.ProcessingFragment"
        android:label="생성중"
        tools:layout="@layout/fragment_processing">
        <argument
            android:name="imagePath"
            app:argType="string" />
        <argument
            android:name="modelId"
            app:argType="string" />
        <action
            android:id="@+id/action_processing_to_result"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.aishotmaker.ui.result.ResultFragment"
        android:label="결과"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="jobId"
            app:argType="string" />
        <action
            android:id="@+id/action_result_to_camera"
            app:destination="@id/cameraFragment" />
        <action
            android:id="@+id/action_result_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/subscriptionFragment"
        android:name="com.aishotmaker.ui.subscription.SubscriptionFragment"
        android:label="구독"
        tools:layout="@layout/fragment_subscription" />

</navigation>
