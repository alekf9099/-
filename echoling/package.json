{
  "name": "echoling",
  "private": true,
  "version": "0.1.0",
  "description": "ECHOLING - 몬스터 테이밍 로그라이크 (Android-first, Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run tests/balance.test.ts",
    "cap:add": "cap add android",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "7.4.0",
    "@capacitor/app": "^7.0.2",
    "@capacitor/cli": "7.4.0",
    "@capacitor/core": "7.4.0"
  }
}
