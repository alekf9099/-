{
  "name": "ride-buddy",
  "productName": "Ride Buddy",
  "version": "1.0.0",
  "description": "바탕화면을 바이크 캐릭터(2D 원본 일러스트 / 3D 렌더)가 천천히 돌아다니다가 알림이 오면 무슨 알림인지 말풍선으로 알려주는 데스크톱 앱",
  "main": "src/main/main.js",
  "author": "alekf9099",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "node -e \"require('child_process').spawn(process.platform==='win32'?'explorer':'xdg-open',[require('path').resolve('src/renderer/index.html')],{detached:true})\"",
    "notify": "node tools/send-notify.js",
    "test": "node --test test/unit.test.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "render3d": "python 3d/ride_buddy_3d.py --motions 3d/out --res 360 --samples 24",
    "render2d": "python 2d/build_2d.py --frames 2d/out --fps 30",
    "pack2d": "python tools/pack_sprites.py 2d/out --skin 2d --fps 30 --display-scale 1.45 --icons --icon-scale 0.42",
    "pack3d": "python tools/pack_sprites.py 3d/out --skin 3d --fps 15"
  },
  "build": {
    "appId": "com.alekf9099.ridebuddy",
    "productName": "Ride Buddy",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ride Buddy"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  }
}
